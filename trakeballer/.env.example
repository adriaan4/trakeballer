# Puerto (Render lo asigna solo, no lo toques en Render)
PORT=3000

# --- AVISO POR EMAIL (Gmail con "contraseña de aplicacion") ---
# Deja EMAIL_USER vacio si no quieres avisos por correo
EMAIL_SERVICE=gmail
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contraseña_de_16_letras
# A que correo te llega el aviso de cada pedido (correo general de la tienda).
# Si lo dejas vacio, el codigo usa por defecto garrogarrez@gmail.com
EMAIL_TO=garrogarrez@gmail.com

# --- ALTERNATIVA SIN GMAIL (si Google no te deja crear contraseñas de aplicacion) ---
# Puedes usar un proveedor SMTP como Brevo (antes Sendinblue), que tiene plan gratis
# y no depende de la verificacion en 2 pasos de una cuenta personal de Gmail.
# Si rellenas EMAIL_HOST, el codigo ignora EMAIL_SERVICE y usa estos datos en su lugar:
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=tu_usuario_de_brevo
# EMAIL_PASS=tu_clave_smtp_de_brevo
# EMAIL_FROM=un_remitente_verificado_en_brevo@tu_dominio.com

# --- AVISO POR SMS / WHATSAPP (Twilio) ---
# Deja TWILIO_ACCOUNT_SID vacio si no quieres usar SMS/WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero de Twilio para SMS, formato +34...
TWILIO_SMS_FROM=
# Tu numero personal donde quieres recibir el SMS, formato +34...
TWILIO_SMS_TO=
# Numero de WhatsApp de Twilio (sandbox o propio), formato whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Tu numero de WhatsApp donde quieres recibir el aviso, formato whatsapp:+34...
TWILIO_WHATSAPP_TO=

# --- CHAT CON IA (widget de la web) ---
# API key gratis de https://console.groq.com
GROQ_API_KEY= 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

